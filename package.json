{
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:check": "scripts/contracts-cli.sh check",
    "contracts:log-check": "scripts/contracts-cli.sh log check",
    "verify": "npm run typecheck && npm test && npm run contracts:check && npm run contracts:log-check"
  }
}
